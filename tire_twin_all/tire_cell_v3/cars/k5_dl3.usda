            string summary = '{"key": "k5_dl3", "label": "기아 K5 DL3 (중형) 2.0 가솔린, 18인치", "curb_mass": 1455.0, "sprung_mass": 1263.1, "unsprung_total": 191.9, "com": [0.0, -0.285, 0.549], "inertia": [2422, 514, 2549], "body_collision_plates": 1048, "jack_points": [[0.65, -1.005], [0.65, 1.005], [-0.65, -1.005], [-0.65, 1.005]], "jack_bottom_z": 0.105, "droop": 0.09, "corners": {"FL": {"tire": "235/45R18", "tire_radius": 0.3343, "wheel_mass": 23.0, "hub_disc_mass": 15.01, "disc_mass": 10.01, "knuckle_mass": 14.0, "disc_d_mm": 305.0, "center": [0.809, -1.425, 0.2323], "wheel_rate_N_per_m": 31432, "corner_sprung_load_kg": 384.5}, "FR": {"tire": "235/45R18", "tire_radius": 0.3343, "wheel_mass": 23.0, "hub_disc_mass": 15.01, "disc_mass": 10.01, "knuckle_mass": 14.0, "disc_d_mm": 305.0, "center": [-0.809, -1.425, 0.2323], "wheel_rate_N_per_m": 31432, "corner_sprung_load_kg": 384.5}, "RL": {"tire": "235/45R18", "tire_radius": 0.3343, "wheel_mass": 23.0, "hub_disc_mass": 9.44, "disc_mass": 5.94, "knuckle_mass": 11.5, "disc_d_mm": 284.0, "center": [0.8125, 1.425, 0.2323], "wheel_rate_N_per_m": 20197, "corner_sprung_load_kg": 247.1}, "RR": {"tire": "235/45R18", "tire_radius": 0.3343, "wheel_mass": 23.0, "hub_disc_mass": 9.44, "disc_mass": 5.94, "knuckle_mass": 11.5, "disc_d_mm": 284.0, "center": [-0.8125, 1.425, 0.2323], "wheel_rate_N_per_m": 20197, "corner_sprung_load_kg": 247.1}}, "nut": {"count": 5, "thread": "M12x1.5", "torque_Nm": [107, 127], "clamp_force_per_nut_N": [44583, 52917]}, "sources": {"official": "전장/전폭/전고/축거/윤거(18인치)/공차중량 1,455 kg(2.0 가솔린 18인치)/타이어 235/45R18 = 기아 K5 제원 (kia.com/kr/vehicles/k5/specification.html). 휠 7.5Jx18, 너트 토크 = 기아 DL3 취급설명서. 디스크 앞 12.0 in 벤틸레이티드 / 뒤 11.2 in 솔리드, 무게 배분 60:40, 최저지상고 5.3 in = 기아 북미 공식 제원 (kiamedia.com, 2025 K5)", "third": "휠 오프셋 ET48", "assumed": "디스크 두께, 오버행 배분, 휠+타이어 23 kg"}}'
