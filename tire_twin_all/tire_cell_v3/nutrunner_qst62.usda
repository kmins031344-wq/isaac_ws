#usda 1.0
(
    defaultPrim = "NutrunnerQST62"
    kilogramsPerUnit = 1
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "NutrunnerQST62" (
    prepend apiSchemas = ["PhysicsArticulationRootAPI"]
    customData = {
        string source = "parametric model from Atlas Copco QST62-230CT published data (not vendor CAD)"
        dictionary spec = {
            double gear_ratio = 19.04
            double mass = 10.2
            string model = "Atlas Copco QST62-230CT-T50-L152-H19"
            double speed_rpm = 330
            double torque_max = 230
            double torque_min = 40
            double travel = 0.05
        }
    }
)
{
    def "Looks"
    {
        def Material "ac_yellow"
        {
            token outputs:surface.connect = </NutrunnerQST62/Looks/ac_yellow/shader.outputs:surface>

            def Shader "shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.93, 0.72, 0.05)
                float inputs:metallic = 0.3
                float inputs:roughness = 0.45
                token outputs:surface
            }
        }

        def Material "ac_dark"
        {
            token outputs:surface.connect = </NutrunnerQST62/Looks/ac_dark/shader.outputs:surface>

            def Shader "shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.1, 0.1, 0.11)
                float inputs:metallic = 0.5
                float inputs:roughness = 0.5
                token outputs:surface
            }
        }

        def Material "ac_steel"
        {
            token outputs:surface.connect = </NutrunnerQST62/Looks/ac_steel/shader.outputs:surface>

            def Shader "shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.62, 0.63, 0.65)
                float inputs:metallic = 1
                float inputs:roughness = 0.25
                token outputs:surface
            }
        }
    }

