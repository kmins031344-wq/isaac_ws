#usda 1.0
(
    defaultPrim = "World"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "World"
{
    def "Looks"
    {
        def Material "floor"
        {
            token outputs:surface.connect = </World/Looks/floor/shader.outputs:surface>

            def Shader "shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.55, 0.55, 0.53)
                float inputs:metallic = 0
                float inputs:roughness = 0.6
                token outputs:surface
            }
        }

        def Material "lift_green"
        {
            token outputs:surface.connect = </World/Looks/lift_green/shader.outputs:surface>

            def Shader "shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.25, 0.7, 0.12)
                float inputs:metallic = 0.2
                float inputs:roughness = 0.5
                token outputs:surface
            }
        }

        def Material "lift_deck"
        {
            token outputs:surface.connect = </World/Looks/lift_deck/shader.outputs:surface>

            def Shader "shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.42, 0.62, 0.36)
                float inputs:metallic = 0.5
                float inputs:roughness = 0.45
                token outputs:surface
            }
        }

        def Material "deck_bump"
        {
            token outputs:surface.connect = </World/Looks/deck_bump/shader.outputs:surface>

            def Shader "shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.36, 0.55, 0.31)
                float inputs:metallic = 0.5
                float inputs:roughness = 0.4
                token outputs:surface
            }
        }
    }

    def Cube "GroundPlane" (
        prepend apiSchemas = ["MaterialBindingAPI", "PhysicsCollisionAPI"]
    )
    {
        rel material:binding = </World/Looks/floor>
        color3f[] primvars:displayColor = [(0.55, 0.55, 0.53)]
        double size = 1
        float3 xformOp:scale = (8, 8, 0.1)
        double3 xformOp:translate = (0, 0, -0.05)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def "LiftPlatform"
    {
        def Cube "body" (
            prepend apiSchemas = ["MaterialBindingAPI"]
        )
        {
            rel material:binding = </World/Looks/lift_green>
            color3f[] primvars:displayColor = [(0.25, 0.7, 0.12)]
            double size = 1
            float3 xformOp:scale = (1.2, 2.4, 0.26)
            double3 xformOp:translate = (0.6, 0, 0.13)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        }

        def Cube "deck" (
            prepend apiSchemas = ["MaterialBindingAPI"]
        )
        {
            rel material:binding = </World/Looks/lift_deck>
            color3f[] primvars:displayColor = [(0.42, 0.62, 0.36)]
            double size = 1
            float3 xformOp:scale = (1.2, 2.4, 0.004)
            double3 xformOp:translate = (0.6, 0, 0.262)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        }

