#usda 1.0
(
    defaultPrim = "NutTray"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "NutTray" (
    customData = {
        dictionary tray = {
            string note = "visual model only (no robot motion). Origin = 브래킷이 리프트 옆면에 닿는 면의 위쪽 가운데, -X 가 바깥(로봇 쪽)"
            double peg_height_mm = 35
            string peg_thread = "M12x1.5"
            int pegs = 40
            string pitch_mm = "55 x 48"
            string plate_mm = "500 x 300 x 12"
            double tilt_deg = 45
        }
    }
)
{
    def "Looks"
    {
        def Material "tray_aluminium"
        {
            token outputs:surface.connect = </NutTray/Looks/tray_aluminium/shader.outputs:surface>

            def Shader "shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.8, 0.81, 0.82)
                float inputs:metallic = 1
                float inputs:roughness = 0.38
                token outputs:surface
            }
        }

        def Material "bracket_green"
        {
            token outputs:surface.connect = </NutTray/Looks/bracket_green/shader.outputs:surface>

            def Shader "shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.45, 0.8, 0.1)
                float inputs:metallic = 0.2
                float inputs:roughness = 0.5
                token outputs:surface
            }
        }

        def Material "peg_steel"
        {
            token outputs:surface.connect = </NutTray/Looks/peg_steel/shader.outputs:surface>

            def Shader "shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.62, 0.63, 0.65)
                float inputs:metallic = 1
                float inputs:roughness = 0.3
                token outputs:surface
            }
        }

        def Material "bolt_dark"
        {
            token outputs:surface.connect = </NutTray/Looks/bolt_dark/shader.outputs:surface>

            def Shader "shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.12, 0.12, 0.13)
                float inputs:metallic = 0.8
                float inputs:roughness = 0.4
                token outputs:surface
            }
        }

        def Material "lug_nut"
        {
            token outputs:surface.connect = </NutTray/Looks/lug_nut/shader.outputs:surface>

            def Shader "shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.72, 0.72, 0.74)
                float inputs:metallic = 1
                float inputs:roughness = 0.22
                token outputs:surface
            }
        }
    }

