            string nut_tray_center = "[0.85, -1.65, 0.3]"
            string nut_tray_nut_positions = "[[0.8701374933083339, -1.840815691900662, 0.15893398282201787], [0.831931282933089, -1.8012520028820362, 0.15893398282201787], [0.7937250725578442, -1.7616883138634103, 0.15893398282201787], [0.7555188621825993, -1.7221246248447846, 0.15893398282201787], [0.7173126518073545, -1.6825609358261586, 0.15893398282201787]]"
            string nut_tray_slots = "[[0.8675942430543497, -1.8432716801224598, 0.1624695167279506], [0.8293880326791049, -1.803707991103834, 0.1624695167279506], [0.79118182230386, -1.7641443020852081, 0.1624695167279506], [0.7529756119286152, -1.7245806130665824, 0.1624695167279506], [0.7147694015533703, -1.6850169240479564, 0.1624695167279506]]"
            string nut_tray_tool_rotation = "[[0.6946583704589973, 0.5086500507968373, -0.5086500507968374], [-0.7193398003386512, 0.4911976443595538, -0.4911976443595539], [0.0, 0.7071067811865476, 0.7071067811865475]]"
            double nutrunner_mass = 12.2
            string nutrunner_path = "/World/RobotB/Nutrunner"
            string params_json = '{"_note": "모든 물리값을 한 곳에 모은 파일. source: spec=제조사/공식 자료, asset=Isaac Sim 에셋 값, assumed=가정(실측/자료 확보 후 교체), derived=계산값", "sim": {"time_steps_per_second": 240, "gravity": 9.81, "articulation_position_iterations": 64, "articulation_velocity_iterations": 4, "_source": "솔버 64/4 = 강의 자료 값, 240 Hz = 좁은 틈(허브 파일럿 0.3 mm) 접촉 안정용 assumed"}, "wheel": {"tire": "225/45R17", "tire_radius": 0.316, "tire_width": 0.225, "rim_radius": 0.2159, "mass": 22.0, "inertia_diag": [0.6, 0.6, 1.06], "pcd_radius": 0.05715, "lugs": 5, "hub_bore_radius": 0.03355, "bore_clearance_sim": 0.0003, "stud_radius": 0.006, "stud_hole_radius": 0.0072, "stud_exposed": 0.045, "pilot_length": 0.012, "_source": "규격 5x114.3 / 보어 67.1 / M12 = spec(현대·기아 준중형·중형), 질량 22 kg = 실측 사례 17~22 kg 의 상한, 관성 = derived(타이어 9.5 kg@r0.28 + 휠 12.5 kg@r0.16), 보어 틈 0.3 mm = assumed(실제 약 0.05 mm, 시뮬 안정용 확대)"}, "car": {"model_mesh": "Toyota Prius (osrf/car_demo, Apache-2.0)", "curb_mass": 1380.0, "unsprung_front": 23.0, "unsprung_rear": 18.0, "com_car_frame": [0.0, -0.27, 0.55], "inertia_diag": [2000.0, 450.0, 2200.0], "suspension_droop": 0.09, "wheel_rate": 25000.0, "wheel_damping": 2500.0, "suspension_preload_travel": 0.03, "bump_travel": 0.16, "brake_locked": true, "_source": "공차중량 1380 kg = spec(Prius 3세대 급, 중형 세단 대용), 스프링 하중량/휠 레이트/감쇠/관성/무게중심 = assumed(일반 승용차 범위)"}, "materials": {"tire_rubber": {"static": 0.9, "dynamic": 0.8, "restitution": 0.05, "_source": "assumed (고무-콘크리트/고무-패드)"}, "pad_rubber": {"static": 0.9, "dynamic": 0.8, "restitution": 0.0, "_source": "assumed"}, "steel": {"static": 0.5, "dynamic": 0.4, "restitution": 0.0, "_source": "assumed (건조 강-강/강-알루미늄)"}, "body_paint": {"static": 0.35, "dynamic": 0.3, "restitution": 0.0, "_source": "assumed"}, "lift_pad": {"static": 0.8, "dynamic": 0.7, "restitution": 0.0, "_source": "assumed"}, "floor": {"static": 0.9, "dynamic": 0.8, "restitution": 0.0, "_source": "assumed"}}, "robot": {"model": "Kawasaki RS080N", "payload": 80.0, "reach": 2.1, "wrist_torque_limit": [336.0, 336.0, 194.0], "wrist_inertia_limit": [34.0, 34.0, 13.7], "joint_stiffness": 10000000.0, "joint_damping": 100000.0, "joint_max_force": 60000.0, "_source": "가반/리치/손목 허용값/관절 범위/최대 속도 = spec, 링크 질량·게인 = asset. joint_max_torque = derived/assumed: 실제 모터 토크는 비공개라, 가반하중 80 kg 을 최대 리치에서 드는 정적 토크(JT2 약 3,000 N·m, JT3 약 1,200 N·m)에 여유 약 2배, 손목은 허용 토크(336/336/194 N·m)의 약 1.5배로 잡음. 에셋 기본값 60,000 N·m 은 차를 끌 수 있을 만큼 비현실적이라 교체", "joint_max_torque": [4000.0, 5500.0, 2500.0, 500.0, 500.0, 300.0]}, "robot_b_base": {"xy": [0.55, -1.25], "yaw_deg": 44.0}, "gripper": {"type": "custom 4-jaw OD gripper (concept)", "stroke": 0.05, "squeeze": 0.006, "jaw_stiffness": 100000.0, "jaw_damping": 10000.0, "jaw_max_force": 1500.0, "base_mass": 16.0, "jaw_mass": 2.0, "_source": "assumed(개념 설계). 조임력 = stiffness x squeeze = 600 N/조"}, "nutrunner": {"model": "Atlas Copco QST62-230CT-T50-L152-H19", "torque_min": 40.0, "torque_max": 230.0, "speed_rpm": 330.0, "travel": 0.05, "mass": 10.2, "square_drive_in": 0.75, "gear_ratio": 19.04, "length_body": 0.517, "length_front": 0.152, "socket_mm": 21, "bracket_mass": 2.0, "_source": "토크/속도/이동/질량/기어비/치수 A=152, C=517 = spec(Atlas Copco 제품 자료), 외형 지름·브래킷 = assumed. 스핀들 이동(50 mm)과 너트 나사 체결은 미구현"}, "demo": {"nut_order": [1, 3, 5, 2, 4], "spin_seconds": 2.0, "wheel_mount_mode": "joint", "protective_stop": {"car_displacement_mm": 3.0, "car_tilt_deg": 0.2, "contact_force_N": 300.0, "wheel_tilt_deg": 1.0, "wheel_sag_mm": 3.0, "_source": "assumed (보호 정지 기준)"}}}'
            string protective_stop = '{"car_displacement_mm": 3.0, "car_tilt_deg": 0.2, "contact_force_N": 300.0, "wheel_tilt_deg": 1.0, "wheel_sag_mm": 3.0, "_source": "assumed (\\ubcf4\\ud638 \\uc815\\uc9c0 \\uae30\\uc900)"}'
            string robot_a = "/World/RobotA"
            string robot_b = "/World/RobotB"
            double spin_rpm = 330
            double spin_seconds = 2
            double stud_exposed = 0.045
            double tip_below_tcp = 0.1305
            double tire_width = 0.225
            string track_base_y = "[0.0, -1.25]"
            string track_joint_a = "/World/RobotA/track_joint"
            string track_joint_b = "/World/RobotB/track_joint"
            double track_length = 5.91
            double track_max_speed = 1
            double track_min_gap = 1
            string track_travel = "[-3.2, 0.4]"
            double3 wheel_center = (1.85, 0, 1)
            double wheel_mass = 22
            string wheel_mount_mode = "joint"
            string wheel_path = "/World/Wheel_FL"
        }
    }
)
{
    def PhysicsScene "PhysicsScene" (
        prepend apiSchemas = ["PhysxSceneAPI"]
    )
    {
        vector3f physics:gravityDirection = (0, 0, -1)
        float physics:gravityMagnitude = 9.81
        custom uint physxScene:timeStepsPerSecond = 240
    }

    def DomeLight "DomeLight"
    {
        float inputs:intensity = 1000
    }

    def DistantLight "SunLight"
    {
        float inputs:intensity = 2500
        float3 xformOp:rotateXYZ = (-40, 25, 0)
        uniform token[] xformOpOrder = ["xformOp:rotateXYZ"]
    }

    def "PhysicsMaterials"
    {
        def Material "tire_rubber" (
            prepend apiSchemas = ["PhysicsMaterialAPI"]
        )
        {
            float physics:dynamicFriction = 0.8
            float physics:restitution = 0.05
            float physics:staticFriction = 0.9
        }

        def Material "pad_rubber" (
            prepend apiSchemas = ["PhysicsMaterialAPI"]
        )
        {
            float physics:dynamicFriction = 0.8
            float physics:restitution = 0
            float physics:staticFriction = 0.9
        }

        def Material "steel" (
            prepend apiSchemas = ["PhysicsMaterialAPI"]
        )
        {
            float physics:dynamicFriction = 0.4
            float physics:restitution = 0
            float physics:staticFriction = 0.5
        }

        def Material "body_paint" (
