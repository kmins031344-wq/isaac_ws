    def Cube "Ground" (
        prepend apiSchemas = ["MaterialBindingAPI", "PhysicsCollisionAPI"]
    )
    {
        rel material:binding = </World/Looks/floor>
        rel material:binding:physics = </World/PhysicsMaterials/floor> (
            bindMaterialAs = "weakerThanDescendants"
        )
        color3f[] primvars:displayColor = [(0.42, 0.43, 0.45)]
        double size = 1
        float3 xformOp:scale = (16, 16, 0.2)
        double3 xformOp:translate = (2, -1, -0.1)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def Xform "RobotA" (
        prepend apiSchemas = ["PhysxArticulationAPI"]
        prepend references = @./rs080n_pzv160_flat.usda@</World/RS080N>
    )
    {
        int physxArticulation:solverPositionIterationCount = 64
        int physxArticulation:solverVelocityIterationCount = 4
        quatd xformOp:orient = (1, 0, 0, 0)
        double3 xformOp:translate = (0, 0, 0.12)

        over "root_joint"
        {
            rel physics:body1 = </World/RobotA/rail_anchor>
            point3f physics:localPos0 = (0, 0, 0.12)
            quatf physics:localRot0 = (1, 0, 0, 0)
        }

        over "Gripper" (
            active = false
        )
        {
        }

        over "base_link"
        {
            over "joint1"
            {
                float drive:angular:physics:maxForce = 4000
            }
        }

        over "link1"
        {
            over "joint2"
            {
                float drive:angular:physics:maxForce = 5500
            }
        }

        over "link2"
        {
            over "joint3"
            {
                float drive:angular:physics:maxForce = 2500
            }
        }

        over "link3"
        {
            over "joint4"
            {
                float drive:angular:physics:maxForce = 500
            }
        }

        over "link4"
        {
            over "joint5"
            {
                float drive:angular:physics:maxForce = 500
            }
        }

        over "link5"
        {
            over "joint6"
            {
                float drive:angular:physics:maxForce = 300
            }
        }

        def Xform "WheelGripper" (
            delete apiSchemas = ["PhysicsArticulationRootAPI"]
            prepend references = @./wheel_gripper_4jaw.usda@
        )
        {
            matrix4d xformOp:transform = ( (-2.028159260536455e-7, -0.9999999999999797, 0, 0), (-0.9999999999999797, 2.028159260536455e-7, 1.2246467991473532e-16, 0), (-1.2246467991473283e-16, 2.4837787465770325e-23, -1, 0), (0.14999979734420776, -8.940697071579962e-9, 2.794999599456787, 1) )
            uniform token[] xformOpOrder = ["xformOp:transform"]

            def PhysicsFixedJoint "flange_mount_joint"
            {
                rel physics:body0 = </World/RobotA/link6>
                rel physics:body1 = </World/RobotA/WheelGripper/base>
                point3f physics:localPos0 = (0, 0, 0)
                point3f physics:localPos1 = (0, 0, 0)
                quatf physics:localRot0 = (0, 1, 0, 0)
                quatf physics:localRot1 = (1, 0, 0, 0)
            }

            over "base" (
                prepend apiSchemas = ["PhysicsFilteredPairsAPI", "PhysxContactReportAPI"]
            )
            {
                rel physics:filteredPairs = [
                    </World/RobotA/world>,
                    </World/RobotA/base_link>,
                    </World/RobotA/link1>,
                    </World/RobotA/link2>,
                    </World/RobotA/link3>,
                    </World/RobotA/link4>,
                    </World/RobotA/link5>,
                    </World/RobotA/link6>,
                ]
                custom float physxContactReport:threshold = 0

                def Cube "Camera_RSD455_bracket" (
                    prepend apiSchemas = ["MaterialBindingAPI"]
                )
                {
                    rel material:binding = </World/RobotA/WheelGripper/Looks/cam_bracket>
                    double size = 1
                    float3 xformOp:scale = (0.0155, 0.06, 0.026)
                    double3 xformOp:translate = (0.13275, 0, -0.027999999999999997)
                    uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
                }
            }

            over "jaw_0" (
                prepend apiSchemas = ["PhysicsFilteredPairsAPI", "PhysxContactReportAPI"]
            )
            {
                rel physics:filteredPairs = [
                    </World/RobotA/world>,
                    </World/RobotA/base_link>,
                    </World/RobotA/link1>,
                    </World/RobotA/link2>,
                    </World/RobotA/link3>,
                    </World/RobotA/link4>,
                    </World/RobotA/link5>,
                    </World/RobotA/link6>,
                ]
                custom float physxContactReport:threshold = 0
            }

            over "jaw_1" (
                prepend apiSchemas = ["PhysicsFilteredPairsAPI", "PhysxContactReportAPI"]
            )
            {
                rel physics:filteredPairs = [
                    </World/RobotA/world>,
                    </World/RobotA/base_link>,
                    </World/RobotA/link1>,
                    </World/RobotA/link2>,
                    </World/RobotA/link3>,
                    </World/RobotA/link4>,
                    </World/RobotA/link5>,
                    </World/RobotA/link6>,
                ]
                custom float physxContactReport:threshold = 0
            }

            over "jaw_2" (
                prepend apiSchemas = ["PhysicsFilteredPairsAPI", "PhysxContactReportAPI"]
            )
            {
                rel physics:filteredPairs = [
                    </World/RobotA/world>,
                    </World/RobotA/base_link>,
                    </World/RobotA/link1>,
                    </World/RobotA/link2>,
                    </World/RobotA/link3>,
                    </World/RobotA/link4>,
                    </World/RobotA/link5>,
                    </World/RobotA/link6>,
                ]
                custom float physxContactReport:threshold = 0
            }

            over "jaw_3" (
                prepend apiSchemas = ["PhysicsFilteredPairsAPI", "PhysxContactReportAPI"]
            )
            {
                rel physics:filteredPairs = [
                    </World/RobotA/world>,
                    </World/RobotA/base_link>,
                    </World/RobotA/link1>,
                    </World/RobotA/link2>,
                    </World/RobotA/link3>,
                    </World/RobotA/link4>,
                    </World/RobotA/link5>,
                    </World/RobotA/link6>,
                ]
                custom float physxContactReport:threshold = 0
            }

            def Xform "Camera_RSD455" (
                customData = {
