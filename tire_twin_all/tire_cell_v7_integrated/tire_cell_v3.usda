    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "World" (
    customData = {
        dictionary cell = {
            string camera_a = "/World/RobotA/WheelGripper/Camera_RSD455/RSD455"
            string camera_b = "/World/RobotB/Nutrunner/Camera_RSD455/RSD455"
            string car_path = "/World/Car"
