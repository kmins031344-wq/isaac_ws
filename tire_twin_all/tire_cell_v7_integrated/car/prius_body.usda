    def "Looks"
    {
        def Material "Hybrid"
        {
            token outputs:surface.connect = </PriusBody/Looks/Hybrid/shader.outputs:surface>

            def Shader "shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor.connect = </PriusBody/Looks/Hybrid/texture.outputs:rgb>
                float inputs:metallic = 0.2
                float inputs:roughness = 0.35
                token outputs:surface
            }

            def Shader "st_reader"
            {
                uniform token info:id = "UsdPrimvarReader_float2"
                token inputs:varname = "st"
                float2 outputs:result
            }

            def Shader "texture"
            {
                uniform token info:id = "UsdUVTexture"
                asset inputs:file = @./Hybrid.png@
                float2 inputs:st.connect = </PriusBody/Looks/Hybrid/st_reader.outputs:result>
                token inputs:wrapS = "repeat"
                token inputs:wrapT = "repeat"
                float3 outputs:rgb
            }
        }

        def Material "Windows"
        {
            token outputs:surface.connect = </PriusBody/Looks/Windows/shader.outputs:surface>

            def Shader "shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.05, 0.07, 0.09)
                float inputs:opacity = 0.45
                float inputs:roughness = 0.05
                token outputs:surface
            }
        }

        def Material "Hybrid_Interior"
        {
            token outputs:surface.connect = </PriusBody/Looks/Hybrid_Interior/shader.outputs:surface>

            def Shader "shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor.connect = </PriusBody/Looks/Hybrid_Interior/texture.outputs:rgb>
                float inputs:metallic = 0.2
                float inputs:roughness = 0.35
                token outputs:surface
            }

            def Shader "st_reader"
            {
                uniform token info:id = "UsdPrimvarReader_float2"
                token inputs:varname = "st"
                float2 outputs:result
            }

            def Shader "texture"
            {
                uniform token info:id = "UsdUVTexture"
                asset inputs:file = @./Hybrid_Interior.png@
                float2 inputs:st.connect = </PriusBody/Looks/Hybrid_Interior/st_reader.outputs:result>
                token inputs:wrapS = "repeat"
                token inputs:wrapT = "repeat"
                float3 outputs:rgb
            }
        }
    }

