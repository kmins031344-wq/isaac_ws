            }
        }

        def Material "lift_yellow"
        {
            token outputs:surface.connect = </World/Looks/lift_yellow/shader.outputs:surface>

            def Shader "shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.9, 0.68, 0.05)
                float inputs:metallic = 0.4
                float inputs:roughness = 0.5
