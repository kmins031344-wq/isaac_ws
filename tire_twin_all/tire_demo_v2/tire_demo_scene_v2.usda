    def Cube "Ground" (
        prepend apiSchemas = ["MaterialBindingAPI", "PhysicsCollisionAPI"]
    )
    {
        rel material:binding = </World/Looks/floor>
        color3f[] primvars:displayColor = [(0.42, 0.43, 0.45)]
        double size = 1
        float3 xformOp:scale = (16, 16, 0.2)
        double3 xformOp:translate = (2, -1, -0.1)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def Xform "RS080N" (
        prepend apiSchemas = ["PhysxArticulationAPI"]
        prepend references = @./rs080n_pzv160_flat.usda@</World/RS080N>
    )
    {
        int physxArticulation:solverPositionIterationCount = 32
        int physxArticulation:solverVelocityIterationCount = 4

        over "Gripper" (
            active = false
        )
        {
        }

        def Xform "WheelGripper" (
            delete apiSchemas = ["PhysicsArticulationRootAPI"]
            prepend references = @./wheel_gripper_4jaw.usda@
        )
        {
            matrix4d xformOp:transform = ( (-2.028159260536455e-7, -0.9999999999999797, 0, 0), (-0.9999999999999797, 2.028159260536455e-7, 1.2246467991473532e-16, 0), (-1.2246467991473283e-16, 2.4837787465770325e-23, -1, 0), (0.14999979734420776, -8.940697071579962e-9, 2.794999599456787, 1) )
            uniform token[] xformOpOrder = ["xformOp:transform"]

            def PhysicsFixedJoint "flange_mount_joint"
            {
                rel physics:body0 = </World/RS080N/link6>
                rel physics:body1 = </World/RS080N/WheelGripper/base>
                point3f physics:localPos0 = (0, 0, 0)
                point3f physics:localPos1 = (0, 0, 0)
                quatf physics:localRot0 = (0, 1, 0, 0)
                quatf physics:localRot1 = (1, 0, 0, 0)
            }

            over "base" (
                prepend apiSchemas = ["PhysicsFilteredPairsAPI"]
            )
            {
                rel physics:filteredPairs = [
                    </World/RS080N/world>,
                    </World/RS080N/base_link>,
                    </World/RS080N/link1>,
                    </World/RS080N/link2>,
                    </World/RS080N/link3>,
                    </World/RS080N/link4>,
                    </World/RS080N/link5>,
                    </World/RS080N/link6>,
                ]
            }

            over "jaw_0" (
                prepend apiSchemas = ["PhysicsFilteredPairsAPI"]
            )
            {
                rel physics:filteredPairs = [
                    </World/RS080N/world>,
                    </World/RS080N/base_link>,
                    </World/RS080N/link1>,
                    </World/RS080N/link2>,
                    </World/RS080N/link3>,
                    </World/RS080N/link4>,
                    </World/RS080N/link5>,
                    </World/RS080N/link6>,
                ]
            }

            over "jaw_1" (
                prepend apiSchemas = ["PhysicsFilteredPairsAPI"]
            )
            {
                rel physics:filteredPairs = [
                    </World/RS080N/world>,
                    </World/RS080N/base_link>,
                    </World/RS080N/link1>,
                    </World/RS080N/link2>,
                    </World/RS080N/link3>,
                    </World/RS080N/link4>,
                    </World/RS080N/link5>,
                    </World/RS080N/link6>,
                ]
            }

            over "jaw_2" (
                prepend apiSchemas = ["PhysicsFilteredPairsAPI"]
            )
            {
                rel physics:filteredPairs = [
                    </World/RS080N/world>,
                    </World/RS080N/base_link>,
                    </World/RS080N/link1>,
                    </World/RS080N/link2>,
                    </World/RS080N/link3>,
                    </World/RS080N/link4>,
                    </World/RS080N/link5>,
                    </World/RS080N/link6>,
                ]
            }

            over "jaw_3" (
                prepend apiSchemas = ["PhysicsFilteredPairsAPI"]
            )
            {
                rel physics:filteredPairs = [
                    </World/RS080N/world>,
                    </World/RS080N/base_link>,
                    </World/RS080N/link1>,
                    </World/RS080N/link2>,
                    </World/RS080N/link3>,
                    </World/RS080N/link4>,
                    </World/RS080N/link5>,
                    </World/RS080N/link6>,
                ]
            }
        }
    }

    def Xform "Car"
    {
        def Xform "Body" (
            prepend references = @./car/prius_body.usda@
        )
        {
            float xformOp:rotateZ = 180
            double3 xformOp:translate = (2.617, -1.41, 0.7899999999999999)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateZ"]
        }

        def Xform "Hub_FL"
        {
            quatf xformOp:orient = (0.70710677, -0, -0.70710677, -0)
            double3 xformOp:translate = (1.85, 0, 0.9999999999999999)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient"]

