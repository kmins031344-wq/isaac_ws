        {
            token outputs:surface.connect = </World/Looks/stud/shader.outputs:surface>

            def Shader "shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.8, 0.72, 0.35)
