        }

        def Material "alloy_dark"
        {
            token outputs:surface.connect = </World/Looks/alloy_dark/shader.outputs:surface>

            def Shader "shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.22, 0.22, 0.24)
                float inputs:metallic = 1
                float inputs:roughness = 0.4
                token outputs:surface
            }
        }

        def Material "lug_nut"
        {
            token outputs:surface.connect = </World/Looks/lug_nut/shader.outputs:surface>

            def Shader "shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.6, 0.6, 0.62)
                float inputs:metallic = 1
                float inputs:roughness = 0.25
                token outputs:surface
            }
        }

        def Material "lift_blue"
        {
            token outputs:surface.connect = </World/Looks/lift_blue/shader.outputs:surface>

            def Shader "shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.08, 0.22, 0.55)
                float inputs:metallic = 0.5
                float inputs:roughness = 0.45
