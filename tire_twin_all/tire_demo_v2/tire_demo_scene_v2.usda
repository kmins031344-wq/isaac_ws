        }

        def Material "alloy"
        {
            token outputs:surface.connect = </World/Looks/alloy/shader.outputs:surface>

            def Shader "shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.78, 0.79, 0.81)
