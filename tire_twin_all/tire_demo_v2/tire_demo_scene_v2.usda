#usda 1.0
(
    defaultPrim = "World"
    kilogramsPerUnit = 1
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "World" (
    customData = {
        dictionary demo = {
            double gripper_mass = 24
            string gripper_path = "/World/RS080N/WheelGripper"
            double jaw_close = 0.05
            double stud_exposed = 0.045
            double tcp_from_flange = 0.2805
            double tip_below_tcp = 0.1305
            double tire_width = 0.225
            double3 wheel_center = (1.85, 0, 1)
            double wheel_mass = 22
        }
    }
)
{
    def PhysicsScene "PhysicsScene" (
        prepend apiSchemas = ["PhysxSceneAPI"]
    )
    {
        vector3f physics:gravityDirection = (0, 0, -1)
        float physics:gravityMagnitude = 9.81
        custom uint physxScene:timeStepsPerSecond = 120
    }

    def DomeLight "DomeLight"
    {
        float inputs:intensity = 1000
    }

    def DistantLight "SunLight"
    {
        float inputs:intensity = 2500
        float3 xformOp:rotateXYZ = (-40, 25, 0)
        uniform token[] xformOpOrder = ["xformOp:rotateXYZ"]
    }

    def "Looks"
    {
        def Material "floor"
        {
            token outputs:surface.connect = </World/Looks/floor/shader.outputs:surface>

            def Shader "shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.42, 0.43, 0.45)
                float inputs:metallic = 0
                float inputs:roughness = 0.8
                token outputs:surface
            }
        }

        def Material "TirePhysics" (
            prepend apiSchemas = ["PhysicsMaterialAPI"]
        )
        {
            float physics:dynamicFriction = 0.8
            float physics:restitution = 0.05
            float physics:staticFriction = 0.9
        }

        def Material "steel"
        {
            token outputs:surface.connect = </World/Looks/steel/shader.outputs:surface>

            def Shader "shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.45, 0.45, 0.47)
                float inputs:metallic = 1
                float inputs:roughness = 0.45
                token outputs:surface
            }
        }

        def Material "cast_iron"
        {
            token outputs:surface.connect = </World/Looks/cast_iron/shader.outputs:surface>

            def Shader "shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.2, 0.2, 0.21)
                float inputs:metallic = 0.6
                float inputs:roughness = 0.7
                token outputs:surface
            }
        }

        def Material "caliper_red"
        {
            token outputs:surface.connect = </World/Looks/caliper_red/shader.outputs:surface>

            def Shader "shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.75, 0.05, 0.05)
                float inputs:metallic = 0.2
                float inputs:roughness = 0.4
                token outputs:surface
            }
        }

