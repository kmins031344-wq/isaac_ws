#usda 1.0
(
    defaultPrim = "WheelGripper4Jaw"
    kilogramsPerUnit = 1
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "WheelGripper4Jaw" (
    prepend apiSchemas = ["PhysicsArticulationRootAPI"]
    customData = {
        string source = "parametric concept design (not vendor CAD)"
    }
)
{
    def "Looks"
    {
        def Material "body_blue"
        {
            token outputs:surface.connect = </WheelGripper4Jaw/Looks/body_blue/shader.outputs:surface>

            def Shader "shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.1, 0.28, 0.55)
                float inputs:metallic = 0.6
                float inputs:roughness = 0.4
                token outputs:surface
            }
        }

        def Material "aluminium"
        {
            token outputs:surface.connect = </WheelGripper4Jaw/Looks/aluminium/shader.outputs:surface>

            def Shader "shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.72, 0.73, 0.75)
                float inputs:metallic = 1
                float inputs:roughness = 0.35
                token outputs:surface
            }
        }

        def Material "rail_steel"
        {
            token outputs:surface.connect = </WheelGripper4Jaw/Looks/rail_steel/shader.outputs:surface>

            def Shader "shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.35, 0.35, 0.37)
                float inputs:metallic = 1
                float inputs:roughness = 0.3
                token outputs:surface
            }
        }

        def Material "housing_dark"
        {
